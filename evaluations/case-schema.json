{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FullFighting/reproduce-research-paper/evaluations/case-schema.json",
  "title": "Codex planning evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "title",
    "expected_outcome",
    "paper",
    "repository",
    "constraints",
    "required_behavior",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "expected_outcome": {
      "enum": [
        "ACCEPTED_FOR_DETERMINISTIC_EXECUTION",
        "REVISE",
        "REJECTED_SCIENTIFIC_SCOPE",
        "REJECTED_SAFETY_OR_PRIVACY",
        "BLOCKED_DATA_OR_LICENSE",
        "BLOCKED_COMPUTE_OR_ACCESS"
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "source_url", "provided_context"],
      "properties": {
        "title": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "provided_context": {"type": "string"}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "source_url", "revision", "provided_context"],
      "properties": {
        "status": {"enum": ["IDENTIFIED", "NOT_IDENTIFIED"]},
        "source_url": {"type": ["string", "null"], "format": "uri"},
        "revision": {"type": ["string", "null"]},
        "provided_context": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "NOT_IDENTIFIED"}}},
          "then": {
            "properties": {
              "source_url": {"type": "null"},
              "revision": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "IDENTIFIED"}}},
          "then": {
            "properties": {
              "source_url": {"type": "string", "format": "uri", "minLength": 1},
              "revision": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true
    },
    "required_behavior": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "url", "retrieved_at", "note"],
        "properties": {
          "claim": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
