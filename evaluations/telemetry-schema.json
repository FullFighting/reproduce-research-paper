{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FullFighting/reproduce-research-paper/evaluations/telemetry-schema.json",
  "title": "Instrumented Codex planning evaluation telemetry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "input",
    "prompt",
    "api",
    "usage",
    "cost",
    "latency_ms",
    "initial_plan",
    "human_review",
    "final_evidence_bundle",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "created_at": {"type": "string", "format": "date-time"},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "paper_source", "repository_source"],
      "properties": {
        "artifact": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "paper_source": {"type": "string"},
        "repository_source": {"type": ["string", "null"]}
      }
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifact", "sha256"],
      "properties": {
        "version": {"type": "string"},
        "artifact": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "response_id", "model_requested", "model_returned", "store"],
      "properties": {
        "endpoint": {"const": "https://api.openai.com/v1/responses"},
        "response_id": {"type": ["string", "null"]},
        "model_requested": {"type": "string"},
        "model_returned": {"type": ["string", "null"]},
        "store": {"const": false}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "cached_input_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "estimated_usd", "pricing_artifact", "pricing_sha256", "notice"],
      "properties": {
        "status": {"enum": ["ESTIMATED", "UNAVAILABLE"]},
        "estimated_usd": {"type": ["number", "null"], "minimum": 0},
        "pricing_artifact": {"type": "string"},
        "pricing_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "notice": {"type": "string"}
      }
    },
    "latency_ms": {"type": "integer", "minimum": 0},
    "initial_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact", "sha256", "model_outcome", "model_reason"],
      "properties": {
        "artifact": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_outcome": {"type": "string"},
        "model_reason": {"type": "string"}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decision", "reason", "modifications"],
      "properties": {
        "status": {"enum": ["PENDING", "COMPLETED"]},
        "decision": {"type": ["string", "null"]},
        "reason": {"type": ["string", "null"]},
        "modifications": {"type": "array", "items": {"type": "object"}}
      }
    },
    "final_evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "provenance_sha256", "reason"],
      "properties": {
        "status": {"enum": ["UNBOUND", "BOUND", "NOT_APPLICABLE"]},
        "path": {"type": ["string", "null"]},
        "provenance_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {"type": "string"}
      }
    }
  }
}
